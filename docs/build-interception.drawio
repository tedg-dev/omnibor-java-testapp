<mxfile host="Electron" agent="OmniBOR">
  <diagram id="intercept-1" name="Build Interception — Standalone vs Sidecar">
    <mxGraphModel dx="1488" dy="868" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" value="Build Observation: Standalone (Kernel-Level) vs Sidecar (Post-Build)" vertex="1">
          <mxGeometry height="40" width="600" x="350" y="20" as="geometry" />
        </mxCell>
        <mxCell id="sa-group" parent="1" style="swimlane;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" value="Standalone Mode (EC2 — Ubuntu 22.04)" vertex="1">
          <mxGeometry height="680" width="520" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="sa-req" parent="sa-group" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;size=15;" value="⚠ Requires:&#xa;• SYS_PTRACE capability&#xa;• strace + bomtrace3 binaries&#xa;• Ubuntu / Debian host" vertex="1">
          <mxGeometry height="80" width="220" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="sa1" parent="sa-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" value="1. strace -f -e trace=openat mvn package&#xa;&#xa;bomtrace3 wraps the build command&#xa;and records every openat() syscall" vertex="1">
          <mxGeometry height="70" width="460" x="20" y="140" as="geometry" />
        </mxCell>
        <mxCell id="sa2" parent="sa-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" value="2. Kernel intercepts syscalls&#xa;&#xa;strace captures every file open:&#xa;  openat(AT_FDCWD, &quot;src/main/java/App.java&quot;, O_RDONLY)&#xa;  openat(AT_FDCWD, &quot;target/classes/App.class&quot;, O_WRONLY)&#xa;&#xa;Produces: /tmp/bomsh_hook_raw_logfile.sha1" vertex="1">
          <mxGeometry height="120" width="460" x="20" y="230" as="geometry" />
        </mxCell>
        <mxCell id="sa3" parent="sa-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;" value="3. bomsh_create_bom_java.py&#xa;&#xa;Parses strace log to map:&#xa;  javac opened App.java → wrote App.class&#xa;  jar opened App.class → wrote app.jar&#xa;&#xa;Produces: OmniBOR treedb (SHA-256 provenance)" vertex="1">
          <mxGeometry height="110" width="460" x="20" y="370" as="geometry" />
        </mxCell>
        <mxCell id="sa4" parent="sa-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;fontStyle=1;" value="4. SPDX Generation + Visualization&#xa;&#xa;java_generator.py combines treedb +&#xa;dependency graph → SPDX 2.3 JSON + HTML viz" vertex="1">
          <mxGeometry height="70" width="460" x="20" y="500" as="geometry" />
        </mxCell>
        <mxCell id="esa12" edge="1" parent="sa-group" source="sa1" style="rounded=1;" target="sa2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esa23" edge="1" parent="sa-group" source="sa2" style="rounded=1;" target="sa3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esa34" edge="1" parent="sa-group" source="sa3" style="rounded=1;" target="sa4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sc-group" parent="1" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" value="Sidecar Mode (CI — Amazon Linux 2023)" vertex="1">
          <mxGeometry height="680" width="520" x="620" y="80" as="geometry" />
        </mxCell>
        <mxCell id="sc-req" parent="sc-group" style="shape=note;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;size=15;" value="✓ No special requirements:&#xa;• No SYS_PTRACE&#xa;• No strace / bomtrace&#xa;• Any OS with JDK + Maven" vertex="1">
          <mxGeometry height="80" width="220" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="sc1" parent="sc-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" value="1. mvn package (unmodified)&#xa;&#xa;Build runs normally with zero&#xa;instrumentation — no strace prefix,&#xa;no env var changes, no wrappers" vertex="1">
          <mxGeometry height="80" width="460" x="20" y="140" as="geometry" />
        </mxCell>
        <mxCell id="sc2" parent="sc-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" value="2. bomsh_create_bom_java.py (no strace log)&#xa;&#xa;Without a strace log, falls back to&#xa;bytecode SourceFile attribute analysis:&#xa;&#xa;For each .class in target/:&#xa;  Read bytes 0-3 (magic: 0xCAFEBABE)&#xa;  Parse constant pool → find SourceFile attr&#xa;  attr value = &quot;App.java&quot;&#xa;  Match to src/main/java/**/App.java by path similarity&#xa;&#xa;Produces: OmniBOR treedb (same schema as standalone)" vertex="1">
          <mxGeometry height="170" width="460" x="20" y="240" as="geometry" />
        </mxCell>
        <mxCell id="sc3" parent="sc-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;" value="3. mvn dependency:tree -DoutputType=dot&#xa;&#xa;Runs Maven&#39;s built-in dep:tree plugin:&#xa;  &quot;com.example:testapp:1.0.0&quot; -&gt; &quot;org.jsoup:jsoup:1.18.3&quot;&#xa;  &quot;com.example:testapp:1.0.0&quot; -&gt; &quot;org.apache.logging.log4j:log4j-core:2.24.3&quot;&#xa;  &quot;org.apache.logging.log4j:log4j-core:2.24.3&quot; -&gt; &quot;org.apache.logging.log4j:log4j-api:2.24.3&quot;&#xa;&#xa;Parser extracts: artifact coords, scope, direct vs transitive" vertex="1">
          <mxGeometry height="130" width="460" x="20" y="430" as="geometry" />
        </mxCell>
        <mxCell id="sc4" parent="sc-group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;fontStyle=1;" value="4. SPDX Generation + Visualization&#xa;&#xa;java_generator.py combines treedb +&#xa;dependency graph → SPDX 2.3 JSON + HTML viz" vertex="1">
          <mxGeometry height="70" width="460" x="20" y="580" as="geometry" />
        </mxCell>
        <mxCell id="esc12" edge="1" parent="sc-group" source="sc1" style="rounded=1;" target="sc2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esc23" edge="1" parent="sc-group" source="sc2" style="rounded=1;" target="sc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="esc34" edge="1" parent="sc-group" source="sc3" style="rounded=1;" target="sc4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="equiv" parent="1" style="shape=doubleArrow;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;arrowWidth=0.4;arrowSize=0.3;" value="Same SPDX Schema&#xa;Different Fidelity" vertex="1">
          <mxGeometry height="50" width="280" x="450" y="800" as="geometry" />
        </mxCell>
        <mxCell id="diff" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;size=20;fontStyle=0;" value="KEY DIFFERENCE&#xa;&#xa;Standalone: kernel-level syscall interception&#xa;(strace sees every file open/close)&#xa;Higher fidelity — observes what actually happened&#xa;&#xa;Sidecar: post-build artifact analysis&#xa;(bytecode SourceFile attr + Maven dep graph)&#xa;Lower fidelity — infers what probably happened&#xa;&#xa;Both produce the same OmniBOR treedb schema&#xa;and feed into the same SPDX generator,&#xa;but standalone captures more (annotation&#xa;processors, resource files, implicit deps)." vertex="1">
          <mxGeometry height="190" width="270" x="1200" y="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
