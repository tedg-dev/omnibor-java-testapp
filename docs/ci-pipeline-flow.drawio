<mxfile host="app.diagrams.net" modified="2026-05-08" agent="OmniBOR" type="device">
  <diagram id="cicd-1" name="CI/CD Pipeline Flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="CI/CD Pipeline Flow — GitHub Actions" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="500" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 1: Trigger -->
        <mxCell id="s1" value="1. git push to main&#xa;(or workflow_dispatch)" style="shape=hexagon;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;size=auto;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Step 2: Checkout -->
        <mxCell id="s2" value="2. actions/checkout@v4&#xa;Clone testapp source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Step 3: Build -->
        <mxCell id="s3-group" value="3. Build Phase — Amazon Linux 2023" style="swimlane;startSize=25;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="310" width="700" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="s3a" value="docker run amazoncorretto:21-al2023" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="s3-group">
          <mxGeometry x="20" y="40" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3b" value="dnf install -y maven" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="s3-group">
          <mxGeometry x="250" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3c" value="mvn package -q&#xa;(compile + JAR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="s3-group">
          <mxGeometry x="440" y="40" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3out" value="Output:&#xa;target/omnibor-java-testapp-1.0.0.jar&#xa;target/classes/**/*.class" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;align=left;spacingLeft=8;size=15;" vertex="1" parent="s3-group">
          <mxGeometry x="250" y="110" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e3ab" style="rounded=1;" edge="1" parent="s3-group" source="s3a" target="s3b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3bc" style="rounded=1;" edge="1" parent="s3-group" source="s3b" target="s3c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3co" style="rounded=1;dashed=1;" edge="1" parent="s3-group" source="s3c" target="s3out"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Step 4: Pull sidecar -->
        <mxCell id="s4" value="4. docker pull&#xa;ghcr.io/tedg-dev/omnibor-sidecar:latest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="280" height="60" as="geometry"/>
        </mxCell>

        <!-- Step 5: Sidecar -->
        <mxCell id="s5-group" value="5. Sidecar Analysis Phase — OmniBOR Container" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="700" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="s5a" value="bomsh_create_bom_java.py&#xa;&#xa;Scan target/*.class files&#xa;Read SourceFile bytecode attr&#xa;Map: class → source.java" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="s5-group">
          <mxGeometry x="20" y="40" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s5b" value="mvn dependency:tree&#xa;-DoutputType=dot&#xa;&#xa;Capture full dependency&#xa;graph (direct + transitive)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="s5-group">
          <mxGeometry x="250" y="40" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s5c" value="java_generator.py&#xa;&#xa;Combine treedb + dep graph&#xa;→ SPDX 2.3 JSON&#xa;(build + analyzed SBOMs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="s5-group">
          <mxGeometry x="480" y="40" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="e5ab" value="treedb" style="rounded=1;fontStyle=2;fontSize=9;" edge="1" parent="s5-group" source="s5a" target="s5c"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5bc" value="dep graph" style="rounded=1;fontStyle=2;fontSize=9;" edge="1" parent="s5-group" source="s5b" target="s5c"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Step 6: Upload -->
        <mxCell id="s6" value="6. actions/upload-artifact@v4&#xa;Upload SPDX JSON as CI artifacts&#xa;(90-day retention)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="700" width="280" height="70" as="geometry"/>
        </mxCell>

        <!-- Edges between major steps -->
        <mxCell id="e12" style="rounded=1;strokeColor=#333;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="rounded=1;strokeColor=#333;" edge="1" parent="1" source="s2" target="s3-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="rounded=1;strokeColor=#333;" edge="1" parent="1" source="s3-group" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="rounded=1;strokeColor=#333;" edge="1" parent="1" source="s4" target="s5-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" style="rounded=1;strokeColor=#82b366;" edge="1" parent="1" source="s5c" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Volume shared between build and sidecar -->
        <mxCell id="vol-note" value="${{ github.workspace }}&#xa;mounted into both containers&#xa;as shared volume" style="shape=parallelogram;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999;fontSize=10;perimeter=parallelogramPerimeter;" vertex="1" parent="1">
          <mxGeometry x="850" y="420" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="evol1" style="dashed=1;strokeColor=#999;" edge="1" parent="1" source="s3-group" target="vol-note"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="evol2" style="dashed=1;strokeColor=#999;" edge="1" parent="1" source="vol-note" target="s5-group"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Legend -->
        <mxCell id="leg-title" value="Legend" style="text;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="100" width="80" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="leg1" value="GitHub Actions step" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="140" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="leg2" value="AL2023 build container" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="180" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="leg3" value="OmniBOR sidecar container" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="220" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="leg4" value="Container registry" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="260" width="160" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
