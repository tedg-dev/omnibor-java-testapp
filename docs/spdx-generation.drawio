        <mxCell id="example" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=9;align=left;spacingLeft=10;fontFamily=Courier New;size=20;" value="Example SPDX Relationship (build SBOM):&#xa;&#xa;{&#xa;  &quot;spdxElementId&quot;: &quot;SPDXRef-Package-root&quot;,&#xa;  &quot;relationshipType&quot;: &quot;DEPENDS_ON&quot;,&#xa;  &quot;relatedSpdxElement&quot;: &quot;SPDXRef-Package-jsoup&quot;&#xa;}&#xa;{&#xa;  &quot;spdxElementId&quot;: &quot;SPDXRef-BuildTool-javac&quot;,&#xa;  &quot;relationshipType&quot;: &quot;BUILD_TOOL_OF&quot;,&#xa;  &quot;relatedSpdxElement&quot;: &quot;SPDXRef-Package-root&quot;&#xa;}" vertex="1">
