<mxfile host="Electron" agent="OmniBOR">
  <diagram id="spdx-1" name="SPDX Generation Flow">
    <mxGraphModel dx="1568" dy="839" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
