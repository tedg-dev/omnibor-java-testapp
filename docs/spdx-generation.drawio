        <mxCell id="eout2" edge="1" parent="1" source="gen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontStyle=2;fontSize=9;" target="analyzed-sbom" value="strip BUILD_TOOL_OF">
          <mxGeometry relative="1" as="geometry" />
